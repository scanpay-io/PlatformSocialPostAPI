{
  "type": "AWS",
  "httpMethod": "POST",
  "uri": "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:145505076425:function:scanpay_update_social_post:${stageVariables.runwayAlias}/invocations",
  "requestTemplates": {
    "application/json": "{\n\"requestContext\": {\"authorizer\": {\"claims\": {\"sub\": \"$util.escapeJavaScript($context.authorizer.claims.sub).replaceAll(\"\\\\'\",\"'\")\"}}},\n\"organization_id\": \"$input.params('organizationid')\",\n\"post_id\": \"$input.params('postid')\",\n  \"content\": $input.json('$.content'),\n  \"destination_url\": $input.json('$.destination_url'),\n  \"platforms\": $input.json('$.platforms'),\n  \"status\": $input.json('$.status'),\n  \"scheduled_date_utc\": $input.json('$.scheduled_date_utc')\n#if($input.path('$').containsKey('meta_social'))\n  ,\"meta_social\":$input.json('$.meta_social')\n#end\n}"
  },
  "passthroughBehavior": "NEVER",
  "contentHandling": "CONVERT_TO_TEXT",
  "timeoutInMillis": 29000,
  "cacheNamespace": "mvztpa",
  "cacheKeyParameters": [],
  "integrationResponses": {
    "200": {
      "statusCode": "200",
      "responseParameters": {
        "method.response.header.Access-Control-Allow-Origin": "'*'"
      }
    },
    "400": {
      "statusCode": "400",
      "selectionPattern": ".*\"Status\":400.*",
      "responseParameters": {
        "method.response.header.Access-Control-Allow-Origin": "'*'"
      },
      "responseTemplates": {
        "application/json": "$input.path('$.errorMessage')\r\n"
      }
    }
  },
  "responseTransferMode": "BUFFERED"
}