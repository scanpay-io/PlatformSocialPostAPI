+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { ActivatedRoute, convertToParamMap, provideRouter, Router } from '@angular/router';
+import { AccountRecoveryPage } from './account-recovery.page';
+
+describe('Password reset validation errors', () => {
+  beforeEach(() => TestBed.configureTestingModule({
+    imports: [AccountRecoveryPage],
+    providers: [provideRouter([]), provideHttpClient(), provideHttpClientTesting(), {
+      provide: ActivatedRoute,
+      useValue: { snapshot: { data: { recoveryMode: 'reset' }, queryParamMap: convertToParamMap({}) } },
+    }],
+  }));
+  afterEach(() => TestBed.inject(HttpTestingController).verify());
+
+  for (const transportStatus of [200, 400, 502]) {
+    it('shows the structured password requirement over HTTP ' + transportStatus, async () => {
+      const navigate = vi.spyOn(TestBed.inject(Router), 'navigate').mockResolvedValue(true);
+      const fixture = TestBed.createComponent(AccountRecoveryPage);
+      await fixture.whenStable();
+      fixture.componentInstance.form.patchValue({ username: 'test-user', code: '123456', password: 'NoNumbers!', confirmPassword: 'NoNumbers!' });
+      fixture.componentInstance.submit();
+      const request = TestBed.inject(HttpTestingController).expectOne(r => r.method === 'PUT' && r.url.endsWith('/password/forgot'));
+      const message = 'Password does not conform to policy: Password must have numeric characters';
+      request.flush({ errorType: 'Exception', errorMessage: JSON.stringify({ Status: 400, Message: message }) }, { status: transportStatus, statusText: 'Response' });
+      await fixture.whenStable();
+      expect(fixture.nativeElement.querySelector('.form-error').textContent).toContain(message);
+      expect(fixture.componentInstance.isSubmitting).toBe(false);
+      expect(navigate).not.toHaveBeenCalled();
+    });
+  }
+
+  it('updates every requirement while typing and when clearing the password', async () => {
+    const fixture = TestBed.createComponent(AccountRecoveryPage);
+    await fixture.whenStable();
+    const input = fixture.nativeElement.querySelector('input[formControlName="password"]') as HTMLInputElement;
+    const rules = () => Array.from(fixture.nativeElement.querySelectorAll('#reset-password-rules li')) as HTMLElement[];
+    expect(rules()).toHaveLength(5);
+    expect(rules().filter(rule => rule.classList.contains('rule-met'))).toHaveLength(0);
+    for (const [password, met] of [['abcdefgh', 2], ['Abcdefgh', 3], ['Abcdefg1', 4], ['Abcdef1!', 5], ['', 0]] as const) {
+      input.value = password;
+      input.dispatchEvent(new Event('input', { bubbles: true }));
+      await fixture.whenStable();
+      expect(rules().filter(rule => rule.classList.contains('rule-met'))).toHaveLength(met);
+    }
+    TestBed.inject(HttpTestingController).expectNone(r => r.method === 'PUT');
+  });
+
+  it('keeps unexpected server details out of the form', async () => {
+    const fixture = TestBed.createComponent(AccountRecoveryPage);
+    await fixture.whenStable();
+    fixture.componentInstance.form.patchValue({ username: 'test-user', code: '123456', password: 'Password123!', confirmPassword: 'Password123!' });
+    fixture.componentInstance.submit();
+    TestBed.inject(HttpTestingController).expectOne(r => r.method === 'PUT').flush({ message: 'private stack trace' }, { status: 500, statusText: 'Server error' });
+    await fixture.whenStable();
+    expect(fixture.nativeElement.querySelector('.form-error').textContent).toContain('We could not complete this request.');
+    expect(fixture.nativeElement.textContent).not.toContain('private stack trace');
+  });
+});
