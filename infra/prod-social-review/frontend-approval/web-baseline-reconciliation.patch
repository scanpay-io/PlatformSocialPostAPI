diff --git a/src/app/shared/forms/password-policy.ts b/src/app/shared/forms/password-policy.ts
new file mode 100644
index 0000000..7b253ff
--- /dev/null
+++ b/src/app/shared/forms/password-policy.ts
@@ -0,0 +1,17 @@
+import { ValidatorFn } from '@angular/forms';
+
+// Verified against the GoGiveAnywhere Cognito pool on 2026-11-10.
+export function passwordRequirements(password: string): ReadonlyArray<{ label: string; valid: boolean }> {
+  return [
+    { label: 'At least 8 characters', valid: Array.from(password).length >= 8 },
+    { label: 'At least one uppercase letter (A–Z)', valid: /[A-Z]/.test(password) },
+    { label: 'At least one lowercase letter (a–z)', valid: /[a-z]/.test(password) },
+    { label: 'At least one number (0–9)', valid: /[0-9]/.test(password) },
+    { label: 'At least one symbol (for example, ! @ # $)', valid: /[\x21-\x2f\x3a-\x40\x5b-\x60\x7b-\x7e]/.test(password) },
+  ];
+}
+
+export const passwordPolicyValidator: ValidatorFn = control =>
+  passwordRequirements(String(control.value ?? '')).every(rule => rule.valid)
+  ? null
+  : { passwordPolicy: true };
