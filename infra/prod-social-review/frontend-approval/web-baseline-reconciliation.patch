+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { provideRouter, Router } from '@angular/router';
+import { AuthSessionService } from '../../core/auth/auth-session.service';
+import { LoginPage } from './login.page';
+
+describe('Login validation messages', () => {
+  beforeEach(() => {
+    localStorage.clear();
+    TestBed.configureTestingModule({ imports: [LoginPage], providers: [provideRouter([]), provideHttpClient(), provideHttpClientTesting()] });
+  });
+  afterEach(() => { TestBed.inject(HttpTestingController).verify(); localStorage.clear(); vi.restoreAllMocks(); });
+
+  for (const mode of ['password', 'mfa', 'new-password'] as const) {
+    for (const format of ['legacy 200', 'legacy 502', 'plain 401', 'capitalized 400', 'unexpected 500', 'empty 400']) {
+      it(mode + ' displays ' + format + ' without creating a session', async () => {
+        const fixture = TestBed.createComponent(LoginPage);
+        await fixture.whenStable();
+        const page = fixture.componentInstance;
+        const http = TestBed.inject(HttpTestingController);
+        const navigate = vi.spyOn(TestBed.inject(Router), 'navigateByUrl').mockResolvedValue(true);
+        page.loginForm.patchValue({ username: 'test-user', password: 'Current123!' });
+        if (mode !== 'password') {
+          page.onSubmit();
+          http.expectOne(r => r.url.endsWith('/login')).flush(mode === 'mfa'
+            ? { account_id: 'test-account', mfa_required_response: { session: 'challenge-session', mfa_type: 'SMS' } }
+            : { new_password_required_response: { session: 'challenge-session' } });
+          await fixture.whenStable();
+          expect(page.challengeMode).toBe(mode);
+          page.loginForm.patchValue({ otpCode: '012345', newPassword: 'Proposed123!', confirmPassword: 'Proposed123!' });
+        }
+        page.onSubmit();
+        const message = mode === 'mfa' ? 'Invalid verification code.' : mode === 'new-password' ? 'Password must have numeric characters.' : 'Incorrect username or password.';
+        const payload = format.startsWith('legacy') ? { errorType: 'Exception', errorMessage: JSON.stringify({ Status: 400, Message: message }) }
+          : format === 'plain 401' ? { message }
+          : format === 'capitalized 400' ? { Message: message }
+          : format === 'empty 400' ? {} : { message: 'private server stack trace' };
+        http.expectOne(r => r.method === 'POST').flush(payload, { status: Number(format.split(' ').at(-1)), statusText: 'Response' });
+        await fixture.whenStable();
+        const fallback = mode === 'mfa'
+          ? 'We could not verify that code. Try the latest code, or go back to login to start a new verification session.'
+          : 'We could not sign you in. Please check your username and password.';
+        expect(page.errorMessage).toBe(format === 'unexpected 500' || format === 'empty 400' ? fallback : message);
+        expect(fixture.nativeElement.textContent).toContain(page.errorMessage);
+        expect(page.isSubmitting).toBe(false);
+        expect(page.challengeMode).toBe(mode);
+        expect(page.successMessage).toBe('');
+        expect(TestBed.inject(AuthSessionService).session()).toBeNull();
+        expect(navigate).not.toHaveBeenCalled();
+        if (mode === 'mfa') expect(page.loginForm.controls.otpCode.value).toBe('');
+      });
+    }
+  }
+});
