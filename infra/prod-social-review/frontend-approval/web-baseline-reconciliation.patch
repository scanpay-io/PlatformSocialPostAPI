+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { ActivatedRoute, convertToParamMap, provideRouter, Router } from '@angular/router';
+import { of } from 'rxjs';
+import { SignupPage } from './signup.page';
+import { MyAccountPage } from '../my-account/my-account.page';
+
+describe('Shared live password checklist', () => {
+  beforeEach(() => {
+    TestBed.configureTestingModule({
+      imports: [SignupPage, MyAccountPage],
+      providers: [provideRouter([]), provideHttpClient(), provideHttpClientTesting(), {
+        provide: ActivatedRoute,
+        useValue: { data: of({ accountTab: 'security' }), snapshot: { queryParamMap: convertToParamMap({}), queryParams: {} } },
+      }],
+    });
+  });
+  afterEach(() => { TestBed.inject(HttpTestingController).verify(); vi.restoreAllMocks(); });
+
+  for (const page of ['organization signup', 'individual signup', 'change password']) {
+    it('updates the five rules and validation on ' + page, async () => {
+      if (page === 'change password') {
+        vi.spyOn(MyAccountPage.prototype, 'ngOnInit').mockImplementation(function(this: MyAccountPage) { this.activeTab.set('security'); });
+      } else {
+        vi.spyOn(TestBed.inject(Router), 'url', 'get').mockReturnValue(page === 'individual signup' ? '/signup/individualsignup' : '/signup/organizationsignup');
+      }
+      const fixture = page === 'change password' ? TestBed.createComponent(MyAccountPage) : TestBed.createComponent(SignupPage);
+      await fixture.whenStable();
+      const controlName = page === 'change password' ? 'newPassword' : 'password';
+      const input = fixture.nativeElement.querySelector('input[formControlName="' + controlName + '"]') as HTMLInputElement;
+      const rules = () => Array.from(fixture.nativeElement.querySelectorAll('.platform-password-requirements li')) as HTMLElement[];
+      const control = fixture.componentInstance instanceof MyAccountPage ? fixture.componentInstance.passwordForm.controls.newPassword : fixture.componentInstance.signupForm.controls.password;
+      expect(rules()).toHaveLength(5);
+      expect(rules().filter(rule => rule.classList.contains('rule-met'))).toHaveLength(0);
+      for (const [password, met] of [['abcdefgh', 2], ['Abcdefgh', 3], ['Abcdefg1', 4], ['Abcdef1#', 5], ['', 0]] as const) {
+        input.value = password;
+        input.dispatchEvent(new Event('input', { bubbles: true }));
+        await fixture.whenStable();
+        expect(rules().filter(rule => rule.classList.contains('rule-met'))).toHaveLength(met);
+        expect(control.valid).toBe(met === 5);
+      }
+      expect(input.getAttribute('aria-describedby')).toContain(page === 'change password' ? 'password-requirements' : 'password-rules');
+      TestBed.inject(HttpTestingController).expectNone(request => request.method === 'POST' || request.method === 'PUT');
+    });
+  }
+});
