+/** Only expose explicit client-validation responses, never HTTP transport diagnostics. */
+export function validationErrorMessage(error: unknown, fallback: string): string {
+  const rejection = structuredApiRejection(error);
+  if (rejection) return rejection.message;
+  if (!isApiRejection(error)) return fallback;
+  if (error instanceof ApiResponseError) return error.message.trim() || fallback;
+  const record = error as Record<string, unknown>;
+  const payload = record['error'];
+  const details = payload && typeof payload === 'object'
+    ? payload as Record<string, unknown>
+    : record;
+  // HttpErrorResponse.message describes transport failure, not the rejected input.
+  if (details['errorType'] || (details === record && 'error' in record)) return fallback;
+  const message = details['message'] ?? details['Message'];
+  return typeof message === 'string' && message.trim() ? message : fallback;
+}
