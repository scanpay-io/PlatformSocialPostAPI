+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { TestBed } from '@angular/core/testing';
+import { ActivatedRoute, convertToParamMap, provideRouter, Router } from '@angular/router';
+import { of } from 'rxjs';
+import { AuthSession } from '../../core/auth/auth-session.service';
+import { SignupPage } from './signup.page';
+import { MyAccountPage } from '../my-account/my-account.page';
+
+describe('Account validation error messages', () => {
+  beforeEach(() => TestBed.configureTestingModule({
+    imports: [SignupPage, MyAccountPage],
+    providers: [provideRouter([]), provideHttpClient(), provideHttpClientTesting(), {
+      provide: ActivatedRoute,
+      useValue: { data: of({ accountTab: 'security' }), snapshot: { queryParamMap: convertToParamMap({}), queryParams: {} } },
+    }],
+  }));
+  afterEach(() => { TestBed.inject(HttpTestingController).verify(); vi.restoreAllMocks(); });
+
+  for (const page of ['organization signup', 'individual signup', 'change password']) {
+    for (const format of ['legacy 200', 'legacy 502', 'plain 400', 'capitalized 400', 'unexpected 500', 'empty 400']) {
+      it(page + ' handles ' + format + ' without success or lost form values', async () => {
+        const router = TestBed.inject(Router);
+        const navigate = vi.spyOn(router, 'navigate').mockResolvedValue(true);
+        if (page === 'change password') {
+          vi.spyOn(MyAccountPage.prototype, 'ngOnInit').mockImplementation(function(this: MyAccountPage) { this.activeTab.set('security'); });
+        } else {
+          vi.spyOn(router, 'url', 'get').mockReturnValue(page === 'individual signup' ? '/signup/individualsignup' : '/signup/organizationsignup');
+        }
+        const fixture = page === 'change password' ? TestBed.createComponent(MyAccountPage) : TestBed.createComponent(SignupPage);
+        const instance = fixture.componentInstance;
+        if (instance instanceof MyAccountPage) {
+          vi.spyOn(instance, 'session').mockReturnValue({ accountId: 'test-account', accountType: 'individual' } as AuthSession);
+        }
+        await fixture.whenStable();
+        if (instance instanceof MyAccountPage) {
+          instance.passwordForm.patchValue({ currentPassword: 'Current1!', newPassword: 'Proposed1#' });
+          instance.changePassword();
+        } else {
+          instance.signupForm.patchValue({ username: 'test-account', email: 'test@example.org', ein: '123456789', password: 'Proposed1#' });
+          instance.onSubmit();
+        }
+        const message = page === 'change password' ? 'Incorrect current password.' : 'Username already exists.';
+        const payload = format.startsWith('legacy') ? { errorType: 'Exception', errorMessage: JSON.stringify({ Status: 400, Message: message }) }
+          : format === 'plain 400' ? { message }
+          : format === 'capitalized 400' ? { Message: message }
+          : format === 'empty 400' ? {} : { message: 'private server stack trace' };
+        const status = Number(format.split(' ').at(-1));
+        TestBed.inject(HttpTestingController).expectOne(request => request.method === (page === 'change password' ? 'PUT' : 'POST')).flush(payload, { status, statusText: 'Response' });
+        await fixture.whenStable();
+        const fallback = page === 'change password' ? 'Unable to change password.' : 'We could not create the account. Please confirm the information and try again.';
+        const expected = format === 'unexpected 500' || format === 'empty 400' ? fallback : message;
+        if (instance instanceof MyAccountPage) {
+          expect(instance.statusMessage()).toBe(expected);
+          expect(instance.statusType()).toBe('error');
+          expect(instance.passwordForm.controls.newPassword.value).toBe('Proposed1#');
+          expect(instance.loading()).toBe(false);
+        } else {
+          expect(instance.errorMessage).toBe(expected);
+          expect(instance.isSubmitting).toBe(false);
+          expect(instance.successMessage).toBe('');
+          expect(instance.signupForm.controls.password.value).toBe('Proposed1#');
+        }
+        expect(fixture.nativeElement.textContent).toContain(expected);
+        expect(fixture.nativeElement.textContent).not.toContain('private server stack trace');
+        expect(navigate).not.toHaveBeenCalled();
+      });
+    }
+  }
+});
