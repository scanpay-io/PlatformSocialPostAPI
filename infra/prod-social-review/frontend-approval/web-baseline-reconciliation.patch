diff --git a/src/app/shared/forms/password-requirements.component.ts b/src/app/shared/forms/password-requirements.component.ts
new file mode 100644
index 0000000..9cc31d6
--- /dev/null
+++ b/src/app/shared/forms/password-requirements.component.ts
@@ -0,0 +1,16 @@
+import { Component, Input } from '@angular/core';
+import { passwordRequirements } from './password-policy';
+
+@Component({
+  selector: 'app-password-requirements',
+  templateUrl: './password-requirements.component.html',
+  styleUrl: './password-requirements.component.css',
+})
+export class PasswordRequirementsComponent {
+  @Input() password = '';
+  @Input({ required: true }) requirementsId = '';
+
+  get rules() {
+    return passwordRequirements(this.password);
+  }
+}
