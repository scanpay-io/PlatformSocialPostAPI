+describe('Social delivery tracking', () => {
+  beforeEach(() => { sessionStorage.clear(); localStorage.clear(); });
+  afterEach(() => vi.restoreAllMocks());
+
+  it('preserves a delivery and original timestamp through checkout', () => {
+    vi.spyOn(Date, 'now').mockReturnValue(1000 + 23 * 3600000);
+    const service = new SocialAttributionService();
+    service.capture(postId, 'campaign', 'social', 1000, 'facebook-' + postId);
+    const checkout = new URL(service.checkoutUrl('https://example.org/give', 'campaign'));
+    expect(checkout.searchParams.get('socialdeliveryid')).toBe('facebook-' + postId);
+    expect(checkout.searchParams.get('socialat')).toBe('1000');
+  });
+
+  it('records a different delivery of the same post as a new landing', async () => {
+    const events = new Subject<NavigationStart>();
+    const serializer = new DefaultUrlSerializer();
+    const service = new SocialAttributionService();
+    const record = vi.fn().mockResolvedValue(undefined);
+    service.initialize({ url: '/', events, parseUrl: (url: string) => serializer.parse(url) } as unknown as Router, record);
+    events.next(new NavigationStart(1, '/give?socialpostid=' + postId + '&socialdeliveryid=facebook-' + postId));
+    await new Promise(resolve => setTimeout(resolve, 0));
+    events.next(new NavigationStart(2, '/give?socialpostid=' + postId + '&socialdeliveryid=threads-' + postId));
+    await new Promise(resolve => setTimeout(resolve, 0));
+    expect(record).toHaveBeenCalledTimes(2);
+    expect(record.mock.calls[0][0].social_delivery_id).toBe('facebook-' + postId);
+    expect(record.mock.calls[1][0].social_delivery_id).toBe('threads-' + postId);
+    expect(record.mock.calls[1][0].click_id).not.toBe(record.mock.calls[0][0].click_id);
+  });
+});
